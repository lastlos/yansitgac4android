<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 127.0.0.1 üzerinde ServerSocket açmak için gerekli (PC adb forward ile bağlanır). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Ses aktarımı (Android 10+ AudioPlaybackCapture). PC kurarken "adb install -g" ile verir. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/simge"
        android:label="@string/uygulama_adi"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".AnaEtkinlik"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".YansitmaServisi"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
